{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@admin/*": ["./src/admin/*"]
    },
  },
  
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/admin/**/*.test.ts",
    "src/admin/**/*.test.tsx",
    "src/admin/components/layout/app-title.tsx",
    "src/admin/components/ui/calendar.tsx",
    "src/admin/hooks/use-table-url-state.ts",
    "src/admin/components/navigation-progress.tsx",
    "src/admin/features/apps/**",
    "src/admin/features/auth/**",
    "src/admin/features/errors/**",
    "src/admin/features/settings/**",
    "src/admin/features/tasks/**",
    "src/admin/features/users/**",
    "src/admin/lib/handle-server-error.ts"
  ]
}
